{
  "name": "ops-aoda-agent",
  "publisher": "ops-aoda-local",
  "version": "1.0.0",
  "displayName": "OPS AODA Agent",
  "description": "Scan the current HTML or Razor source document for supported accessibility issues.",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Linters"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "opsAoda.scanCurrentPage",
        "title": "Scan Current Page",
        "category": "OPS AODA"
      },
      {
        "command": "opsAoda.showScanIssues",
        "title": "Show Scan Issues",
        "category": "OPS AODA"
      },
      {
        "command": "opsAoda.openAgentUI",
        "title": "Open Agent UI",
        "category": "OPS AODA"
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/scanner.test.cjs tests/currentPageScanning.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MattBerania/AODA_AGENT.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/MattBerania/AODA_AGENT/issues"
  },
  "homepage": "https://github.com/MattBerania/AODA_AGENT#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "1.95.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "parse5": "^7.3.0"
  }
}
