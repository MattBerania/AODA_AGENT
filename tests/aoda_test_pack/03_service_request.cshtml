@{
    ViewData["Title"] = "Service Request";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Service Request</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 720px; margin: 36px auto; padding: 0 20px; line-height: 1.5; }
    label { display: block; margin: 14px 0 4px; }
    input, textarea, select { padding: 8px; width: 100%; max-width: 380px; }
    button { padding: 10px 18px; margin-top: 16px; }
    img { max-width: 100%; }
    iframe { width: 100%; height: 150px; border: 1px solid #ccc; }
  </style>
</head>
<body>
  <header>
    <h1>Submit a Service Request</h1>
    <p>Complete the form to send a request to the service desk.</p>
    <img src="/images/service-desk-banner.jpg" width="620" height="160" />
  </header>

  <main>
    <form action="/requests/create" method="post">
      <label for="requester-name">Full name</label>
      <input id="requester-name" name="requester-name" type="text" />

      <input id="requester-phone" name="requester-phone" type="tel" placeholder="Phone number" />

      <label for="category">Request category</label>
      <select id="category" name="category">
        <option value="general">General inquiry</option>
        <option value="technical">Technical assistance</option>
      </select>

      <label for="details">Request details</label>
      <textarea id="details" name="details" rows="4"></textarea>

      <button type="submit"></button>
    </form>

    <h2>Instructions</h2>
    <p><a href="/requests/help">Read the request guide</a></p>
    <iframe src="/requests/tutorial"></iframe>
  </main>
</body>
</html>
